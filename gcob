#!/usr/bin/env bash

set -euo pipefail

# Team/personal default ticket prefix. Override by exporting GCOB_DEFAULT_PREFIX
# yourself, or by setting it in ~/.gcobrc (a plain shell file that gets sourced).
# An already-exported GCOB_DEFAULT_PREFIX takes precedence over ~/.gcobrc.
if [[ -z "${GCOB_DEFAULT_PREFIX:-}" && -f "$HOME/.gcobrc" ]]; then
    # shellcheck disable=SC1090
    source "$HOME/.gcobrc"
fi
DEFAULT_TICKET_PREFIX="${GCOB_DEFAULT_PREFIX:-DEV}"

# Strip/replace characters that are invalid in a git ref, then collapse
# repeated separators and trim leading/trailing separators.
sanitize_branch_part() {
    local s="$1"
    s="$(printf '%s' "$s" | tr -c 'A-Za-z0-9._/-' '-')"
    while [[ "$s" == *--* ]]; do s="${s//--/-}"; done
    while [[ "$s" == *..* ]]; do s="${s//../.}"; done
    while [[ "$s" == .* || "$s" == -* || "$s" == /* ]]; do s="${s:1}"; done
    while [[ "$s" == *. || "$s" == *- || "$s" == */ ]]; do s="${s%?}"; done
    printf '%s' "$s"
}

usage() {
    cat <<EOF
Usage:
  $(basename "$0") [-f|-c|-t] [--no-prefix|--np|--force] [--prefix=X] [--number=N] [--dry-run] <branch-name>

Options:
  -f                        Create a feature branch (feat/<branch-name>)
  -c                        Create a chore branch (chore/<branch-name>)
  -t                        Create a test branch (test/<branch-name>)
  --prefix=X                Ticket prefix (e.g. DEV, JIRA). Skips the prefix prompt.
  --number=N,
  --ticket-number=N         Ticket number (e.g. 8532). Skips the number prompt.
  --no-prefix,
  --np,
  --force                   Skip the ticket prompt entirely (no DEV-XXX inserted)
  --dry-run, --dry          Print the branch name without prompting or creating it
  --help                    Show this help message

By default you'll be prompted for a ticket prefix (default $DEFAULT_TICKET_PREFIX) and
ticket number, which are inserted into the branch name. Any prompt is
skipped if its value was already supplied via flag or auto-detected.
Set the default prefix for your team/yourself via ~/.gcobrc or the
GCOB_DEFAULT_PREFIX env var instead of retyping it every time.

If one of the branch-name words already looks like a ticket (e.g.
DEV-837), it's extracted automatically and both prompts are skipped.

Characters that aren't valid in a git branch name (spaces aside, since
words are hyphen-joined) are stripped or replaced, e.g. "wip: fix!" -> "wip-fix".

Examples:
  gcob login-page
  gcob -f add login page
    > Ticket prefix (default $DEFAULT_TICKET_PREFIX):
    > Ticket number: 837
    Creates: feat/DEV-837-add-login-page

  gcob -f DEV-837 add flame feature
    Creates: feat/DEV-837-add-flame-feature   (no prompts)

  gcob -f --prefix=JIRA --number=42 fix login bug
    Creates: feat/JIRA-42-fix-login-bug       (no prompts)

  gcob -c --no-prefix update dependencies
    Creates: chore/update-dependencies

  gcob -f --dry-run DEV-837 add flame feature
    [dry run] feat/DEV-837-add-flame-feature  (nothing created)
EOF
}

PREFIX=""
SKIP_TICKET_PROMPT=false
CLI_TICKET_PREFIX=""
CLI_TICKET_NUMBER=""
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f)
            PREFIX="feat/"
            shift
            ;;
        -c)
            PREFIX="chore/"
            shift
            ;;
        -t)
            PREFIX="test/"
            shift
            ;;
        --no-prefix|--np|--force)
            SKIP_TICKET_PROMPT=true
            shift
            ;;
        --prefix=*)
            CLI_TICKET_PREFIX="${1#*=}"
            shift
            ;;
        --number=*|--ticket-number=*)
            CLI_TICKET_NUMBER="${1#*=}"
            shift
            ;;
        --dry-run|--dry)
            DRY_RUN=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ "$SKIP_TICKET_PROMPT" == true && ( -n "$CLI_TICKET_PREFIX" || -n "$CLI_TICKET_NUMBER" ) ]]; then
    echo "Error: --no-prefix/--np/--force cannot be combined with --prefix or --number/--ticket-number."
    exit 1
fi

if [[ -n "$CLI_TICKET_NUMBER" && ! "$CLI_TICKET_NUMBER" =~ ^[0-9]+$ ]]; then
    echo "Error: ticket number must be numeric: $CLI_TICKET_NUMBER"
    exit 1
fi

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

# Auto-detect a ticket token (e.g. DEV-837) among the branch-name words,
# unless one was already given via flag or the prompt is being skipped.
if [[ "$SKIP_TICKET_PROMPT" == false && -z "$CLI_TICKET_PREFIX" && -z "$CLI_TICKET_NUMBER" ]]; then
    REMAINING=()
    for word in "$@"; do
        if [[ -z "$CLI_TICKET_NUMBER" && "$word" =~ ^([A-Za-z][A-Za-z0-9]*)-([0-9]+)$ ]]; then
            CLI_TICKET_PREFIX="${BASH_REMATCH[1]}"
            CLI_TICKET_NUMBER="${BASH_REMATCH[2]}"
            continue
        fi
        REMAINING+=("$word")
    done
    set -- "${REMAINING[@]}"
fi

if [[ $# -lt 1 ]]; then
    echo "Error: no branch description left after removing the ticket token."
    exit 1
fi

# Join all remaining arguments with hyphens
BRANCH_NAME="$(printf '%s-' "$@")"
BRANCH_NAME="${BRANCH_NAME%-}"
BRANCH_NAME="$(sanitize_branch_part "$BRANCH_NAME")"

if [[ -z "$BRANCH_NAME" ]]; then
    echo "Error: branch name is empty after removing invalid characters."
    exit 1
fi

if [[ "$SKIP_TICKET_PROMPT" == false && "$DRY_RUN" == false ]]; then
    if [[ -z "$CLI_TICKET_PREFIX" ]]; then
        read -rp "Ticket prefix (default $DEFAULT_TICKET_PREFIX): " CLI_TICKET_PREFIX
        CLI_TICKET_PREFIX="${CLI_TICKET_PREFIX:-$DEFAULT_TICKET_PREFIX}"
    fi

    if [[ -z "$CLI_TICKET_NUMBER" ]]; then
        read -rp "Ticket number: " CLI_TICKET_NUMBER
        if [[ -n "$CLI_TICKET_NUMBER" && ! "$CLI_TICKET_NUMBER" =~ ^[0-9]+$ ]]; then
            echo "Error: ticket number must be numeric: $CLI_TICKET_NUMBER"
            exit 1
        fi
    fi
fi

TICKET=""
if [[ -n "$CLI_TICKET_NUMBER" ]]; then
    CLI_TICKET_PREFIX="${CLI_TICKET_PREFIX:-$DEFAULT_TICKET_PREFIX}"
    CLI_TICKET_PREFIX="$(sanitize_branch_part "$CLI_TICKET_PREFIX" | tr '[:lower:]' '[:upper:]')"
    TICKET="${CLI_TICKET_PREFIX}-${CLI_TICKET_NUMBER}-"
fi

BRANCH="${PREFIX}${TICKET}${BRANCH_NAME}"

if [[ "$DRY_RUN" == true ]]; then
    echo "[dry run] Would create and check out branch:"
    echo "  $BRANCH"
    exit 0
fi

echo "Creating and checking out branch:"
echo "  $BRANCH"
echo

git checkout -b "$BRANCH"

echo
echo "✓ Switched to new branch '$BRANCH'"
